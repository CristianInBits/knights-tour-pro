# Java & Gradle project .gitignore

# Build output
/build/
/out/
/bin/

# Gradle cache
.gradle/

# IDEs
.idea/
*.iml
.vscode/

# Logs
*.log

# Compiled class files
*.class

# Package files
*.jar
*.war
*.ear
*.zip
*.tar.gz
*.rar

# JVM crash logs
hs_err_pid*
replay_pid*

# BlueJ
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# OS generated files
.DS_Store
Thumbs.db

# Runtime exports (CLI and GUI)
/output/
/output1_gui/
/output2_gui/

# Keep the Gradle wrapper JAR: this negation must stay AFTER the *.jar rule above
!gradle/wrapper/gradle-wrapper.jar
